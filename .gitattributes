# Git LFS tracking for binary assets shipped with examples / fixtures.
# Source-of-truth: example videos and any other large media live in LFS so the
# repo stays cloneable without dragging dozens of MB on every checkout.
#
# Reminder: a path also has to be NOT covered by .gitignore for these patterns
# to take effect — e.g. exploration/ and .weave-cli/ are gitignored and any
# media in them stays local.
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.mov  filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.mkv  filter=lfs diff=lfs merge=lfs -text
*.m4v  filter=lfs diff=lfs merge=lfs -text
# Audio assets shipped with examples (e.g. generated voiceover) also live in LFS.
*.mp3  filter=lfs diff=lfs merge=lfs -text
*.wav  filter=lfs diff=lfs merge=lfs -text
*.m4a  filter=lfs diff=lfs merge=lfs -text
