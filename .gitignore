# Local-only exploration / investigation artifacts — kept out of the repo.
# (`*.mp4` is intentionally NOT here — tracked video assets land in LFS via
# .gitattributes. Local renders stay out via the .weave-cli/, exploration/,
# and outputs/ directory ignores.)
.weave-cli/
exploration/
outputs/
# Engine bug reports are local-only notes (upstream feedback), not shipped in
# this public distribution repo. Keep all bug-report-*.md out of git.
bug-report-*.md
scripts/__pycache__/
.superpowers/
.DS_Store
# fal API key — local secret, never commit
.fal.key.donotcommit
