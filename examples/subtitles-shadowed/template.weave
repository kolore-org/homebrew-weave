<!DOCTYPE html><html><head><meta charset="utf-8"><style>
/* ───────────────────────────────────────────────────────────────────────────
   SHADOW ATLAS — a self-describing subtitle showcase.

   Each cue is one word that NAMES and DEMONSTRATES a distinct shadow technique,
   drawn from a single curated palette so the variety reads as cohesive:
       cyan #19e3ff · magenta #ff2bd6 · amber #ffae00 · lime #b6ff3b   on near-black.

   Engine notes (verified on weave-viewer-cli 0.3.1):
     • text-shadow: px AND em offsets both resolve; multiple comma layers, blur,
       and per-layer color all work, and it inherits correctly (the 0.1.7
       em/no-inherit defects are fixed). We still declare it directly on each
       styled element — no reliance on cascade surprises.
     • box-shadow: spread (ring), offset, and inset all render — used here for the
       CARD cue and for the page vignette (verified primitive, no CSS gradient).
     • filter: drop-shadow(): stacks multiple colored blurs cleanly on text (HALO).
     • -webkit-text-stroke is NOT supported → OUTLINE is emulated with an 8-way
       px text-shadow.
   ─────────────────────────────────────────────────────────────────────────── */
@import url('https://fonts.googleapis.com/css2?family=Oswald:wght@600;700&family=Space+Mono:wght@400;700&display=swap');

html,body{margin:0;padding:0}
body{width:576px;height:1024px;background:#0a0a14;position:relative;overflow:hidden;
  font-family:'Oswald',sans-serif;color:#f3f4f8}

/* Vignette + faint top wash, built only from box-shadow insets (no gradients). */
.stage{position:absolute;inset:0;
  box-shadow:inset 0 0 220px 40px #00000099,
             inset 0 170px 200px -150px #19e3ff22,
             inset 0 -160px 200px -150px #ff2bd61a}

/* Persistent header + amber rule. */
.head{position:absolute;top:96px;left:0;right:0;text-align:center;
  font-family:'Space Mono',monospace;font-weight:700;font-size:22px;
  letter-spacing:13px;text-indent:13px;color:#a6ecff;
  text-shadow:0 0 10px #19e3ff66,0 0 22px #19e3ff33}
.rule{position:absolute;top:140px;left:50%;width:118px;height:2px;margin-left:-59px;
  background:#ffae00;box-shadow:0 0 10px #ffae00aa}

/* Footer tag. */
.foot{position:absolute;bottom:78px;left:0;right:0;text-align:center;
  font-family:'Space Mono',monospace;font-size:16px;letter-spacing:4px;
  text-indent:4px;color:#465065}

/* ── Cue carrier: centered, fades in/holds/fades out over its timing window. ── */
.cue{position:absolute;left:0;right:0;top:50%;transform:translateY(-50%);
  text-align:center;opacity:0;
  animation-name:cue;animation-timing-function:ease;animation-fill-mode:both}
@keyframes cue{0%{opacity:0}13%{opacity:1}85%{opacity:1}100%{opacity:0}}

.word{font-weight:700;font-size:108px;line-height:1;letter-spacing:1px}
.cap{margin-top:30px;font-family:'Space Mono',monospace;font-weight:400;
  font-size:23px;letter-spacing:3px;text-indent:3px;color:#828ea6;
  text-transform:uppercase}

/* ── The shadow techniques (one class per cue) ──────────────────────────────── */

/* 1 · NEON — layered zero-offset blurs build an outer glow. */
.neon{color:#dffaff;
  text-shadow:0 0 6px #19e3ff,0 0 16px #19e3ff,0 0 34px #0bb8ff,0 0 64px #0bb8ff}

/* 2 · EXTRUDE — a staircase of 1px hard offsets reads as a 3-D solid, then one
       soft layer casts it onto the floor. */
.extrude{color:#ffd35e;
  text-shadow:1px 1px 0 #c0392b,2px 2px 0 #b53420,3px 3px 0 #a8311e,
              4px 4px 0 #9a2e1c,5px 5px 0 #882819,6px 6px 0 #6f2014,
              10px 12px 16px #00000088}

/* 3 · EMBOSS — a light layer below + a dark layer above press the glyph INTO the
       surface (engraved). */
.emboss{color:#aeb4c4;
  text-shadow:0 -1px 1px #000000bb,0 1px 1px #ffffff30,0 3px 6px #00000055}

/* 4 · OUTLINE — eight px offsets ring the glyph; -webkit-text-stroke is
       unsupported, so this is the reliable hollow-letter recipe. */
.outline{color:#0a0a14;
  text-shadow:-2px -2px 0 #b6ff3b,2px -2px 0 #b6ff3b,-2px 2px 0 #b6ff3b,
              2px 2px 0 #b6ff3b,0 -2px 0 #b6ff3b,0 2px 0 #b6ff3b,
              -2px 0 0 #b6ff3b,2px 0 0 #b6ff3b,0 0 14px #b6ff3b55}

/* 5 · GLITCH — opposing horizontal offsets in two colors fake a chromatic split. */
.glitch{color:#f3f4f8;
  text-shadow:-3px 0 0 #19e3ff,3px 0 0 #ff2bd6,
              -3px 0 9px #19e3ff66,3px 0 9px #ff2bd666}

/* 6 · STACK — four offset layers in four palette colours: "various colours" made
       literal — a diagonal rainbow staircase. */
.stack{color:#ffffff;
  text-shadow:3px 3px 0 #19e3ff,6px 6px 0 #b6ff3b,9px 9px 0 #ffae00,12px 12px 0 #ff2bd6}

/* 7 · HALO — filter:drop-shadow() stacks two coloured blurs around the element
       (works through alpha; text-shadow can't blur this evenly). */
.halo{color:#ffffff;
  filter:drop-shadow(0 0 10px #ff2bd6) drop-shadow(0 0 26px #19e3ff)
         drop-shadow(5px 7px 0 #00000088)}

/* 8 · CARD — box-shadow on a panel: a magenta ring (spread), a cyan hard offset,
       and an inner inset for depth. */
.card{display:block;width:300px;height:128px;line-height:128px;margin:0 auto;
  font-size:38px;letter-spacing:2px;border-radius:14px;background:#15152a;color:#eef0f7;
  box-shadow:0 0 0 3px #ff2bd6,16px 16px 0 #19e3ff55,inset 0 0 34px #000000aa}
</style></head><body>
  <div class="stage"></div>
  <div class="head">SHADOW&nbsp;ATLAS</div>
  <div class="rule"></div>

  <div class="cue" style="animation-delay:0.35s;animation-duration:1.50s">
    <div class="word neon">NEON</div>
    <div class="cap">text-shadow · layered glow</div></div>

  <div class="cue" style="animation-delay:1.85s;animation-duration:1.50s">
    <div class="word extrude">EXTRUDE</div>
    <div class="cap">text-shadow · stacked offsets</div></div>

  <div class="cue" style="animation-delay:3.35s;animation-duration:1.50s">
    <div class="word emboss">EMBOSS</div>
    <div class="cap">text-shadow · engraved pair</div></div>

  <div class="cue" style="animation-delay:4.85s;animation-duration:1.50s">
    <div class="word outline">OUTLINE</div>
    <div class="cap">text-shadow · 8-way stroke</div></div>

  <div class="cue" style="animation-delay:6.35s;animation-duration:1.50s">
    <div class="word glitch">GLITCH</div>
    <div class="cap">text-shadow · chromatic split</div></div>

  <div class="cue" style="animation-delay:7.85s;animation-duration:1.50s">
    <div class="word stack">STACK</div>
    <div class="cap">text-shadow · four colours</div></div>

  <div class="cue" style="animation-delay:9.35s;animation-duration:1.50s">
    <div class="word halo">HALO</div>
    <div class="cap">filter · drop-shadow()</div></div>

  <div class="cue" style="animation-delay:10.85s;animation-duration:1.75s">
    <div class="card">box-shadow</div>
    <div class="cap">box-shadow · ring + inset</div></div>

  <div class="foot">RICH SHADOWS · ONE PALETTE</div>
</body></html>
