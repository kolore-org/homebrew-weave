<!DOCTYPE html><html><head><style>
/* Typewriter subtitle example — every character is its own <span>
   with a staggered opacity animation. Reveals at constant 50ms intervals
   (~20 chars/sec) starting from each cue's first-word timing[0].

   Layout choices:
   - white-space:nowrap on the cue keeps the typed line stable (no reflow
     as characters appear). Long cues will extend horizontally; the body's
     overflow:hidden clips anything past 576px.
   - Spaces between words are &nbsp; inside their own <span> (the literal
     whitespace BETWEEN sibling spans would otherwise be dropped per the
     filed inter-span-whitespace bug). NBSP also means lines never wrap,
     which suits a fixed single-line typewriter.
   - .cue handles overall show/hide (step opacity, no fade) like the other
     examples.
   - Per-char animation is `from opacity:0 to opacity:1` over 50ms — light
     fade-in per character. Set `animation-duration:0.001s` and
     `animation-timing-function:step-end` if a hard pop is preferred.

   Cue character counts:  15 / 39 / 25 / 17 / 28 / 15  =  139 spans total.
*/
@import url('https://fonts.googleapis.com/css2?family=Cabin+Sketch:wght@400;700&display=swap');
html,body{margin:0;padding:0}
body{width:576px;height:1024px;background:#000;position:relative;overflow:hidden;
  font-family:'Cabin Sketch',cursive;text-align:center;color:#fff}
video{position:absolute;inset:0;width:576px;height:1024px;object-fit:cover}

.cue{position:absolute;left:0;right:0;top:62%;
  font-size:30px;font-weight:700;line-height:1.2;
  white-space:nowrap;
  opacity:0;
  animation-name:cueshow;animation-timing-function:linear;animation-fill-mode:forwards}
@keyframes cueshow{
  0%, 99.99% { opacity:1 }
  100% { opacity:0 }
}

.ch{display:inline;
  opacity:0;
  animation-name:reveal;
  animation-duration:0.05s;
  animation-timing-function:linear;
  animation-fill-mode:forwards}
@keyframes reveal{
  from { opacity:0 }
  to   { opacity:1 }
}
</style></head><body>
  <video src="dude.mp4" muted></video>

  <!-- Cue 1: "Ehrlich gesagt,"  start=0.24s  (15 chars, types in 0.700s) -->
  <div class="cue" style="animation-delay:0.240s;animation-duration:0.800s">
    <span class="ch" style="animation-delay:0.240s">E</span>
    <span class="ch" style="animation-delay:0.290s">h</span>
    <span class="ch" style="animation-delay:0.340s">r</span>
    <span class="ch" style="animation-delay:0.390s">l</span>
    <span class="ch" style="animation-delay:0.440s">i</span>
    <span class="ch" style="animation-delay:0.490s">c</span>
    <span class="ch" style="animation-delay:0.540s">h</span>
    <span class="ch" style="animation-delay:0.590s">&nbsp;</span>
    <span class="ch" style="animation-delay:0.640s">g</span>
    <span class="ch" style="animation-delay:0.690s">e</span>
    <span class="ch" style="animation-delay:0.740s">s</span>
    <span class="ch" style="animation-delay:0.790s">a</span>
    <span class="ch" style="animation-delay:0.840s">g</span>
    <span class="ch" style="animation-delay:0.890s">t</span>
    <span class="ch" style="animation-delay:0.940s">,</span>
  </div>

