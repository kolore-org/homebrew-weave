  <!-- Cue 5: "langsamer Kaffee, gutes Buch"  [7.221, 10.160] dur=2.939s -->
  <div class="cue" style="animation-delay:7.221s;animation-duration:2.939s">
    <span class="ch" style="animation-delay:7.221s">l</span>
