    <span class="ch" style="animation-delay:7.714s">m</span>
    <span class="ch" style="animation-delay:7.796s">e</span>
    <span class="ch" style="animation-delay:7.878s">r</span>
    <span class="ch" style="animation-delay:7.961s">&nbsp;</span>
