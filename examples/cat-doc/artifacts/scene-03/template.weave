<!DOCTYPE html><html><head><meta charset="utf-8"><style>
@import url('https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;700&family=Space+Mono:wght@400;700&display=swap');
html,body{margin:0;padding:0}
body{width:1280px;height:720px;position:relative;overflow:hidden;background:#000;
  font-family:'Oswald',sans-serif;color:#fff}
*{text-shadow:1px 0 0 #000,-1px 0 0 #000,0 1px 0 #000,0 -1px 0 #000,2px 2px 0 rgba(0,0,0,.6)}
.vid{position:absolute;inset:0;width:1280px;height:720px;object-fit:cover}

.vignette{position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(125% 95% at 50% 46%, rgba(0,0,0,0) 52%, rgba(0,0,0,.6) 100%)}
.grade{position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(180deg, rgba(8,16,14,.32) 0%, rgba(0,0,0,0) 24%, rgba(0,0,0,0) 62%, rgba(4,9,8,.58) 100%)}

/* topbar */
.topbar{position:absolute;top:36px;left:48px;display:flex;align-items:center;gap:14px;
  opacity:0;animation:fade .5s ease-out .2s forwards}
.rec{width:13px;height:13px;border-radius:50%;background:#ff3b30;animation:blink 1.4s steps(1,end) infinite}
.topbar .lbl{font-family:'Space Mono',monospace;font-size:17px;letter-spacing:.34em;font-weight:700}
@keyframes blink{0%,49%{opacity:1}50%,100%{opacity:.12}}

/* velocity v/t HUD (top-right) */
.hud{position:absolute;top:116px;right:48px;width:300px;padding:16px 18px 18px;
  background:rgba(7,15,12,.78);border:1px solid rgba(81,224,138,.32);border-radius:4px;
  opacity:0;transform:translateY(-12px);animation:rise .6s ease-out .5s forwards}
.hud .h{display:flex;justify-content:space-between;align-items:baseline;
  font-family:'Space Mono',monospace;margin-bottom:12px}
.hud .h b{font-size:15px;letter-spacing:.16em;font-weight:700}
.hud .h i{font-size:12px;letter-spacing:.2em;font-style:normal;color:#51e08a}
.graph{position:relative;width:264px;height:120px}
.graph svg{position:absolute;left:0;top:0}
.curve{opacity:0;animation:fade .35s ease-out .8s forwards}
.dot{position:absolute;width:12px;height:12px;border-radius:50%;background:#51e08a;
  left:0;top:0;opacity:0;
  animation:dotin .2s ease-out .8s forwards, plot 2s linear .8s forwards}
@keyframes dotin{to{opacity:1}}
@keyframes plot{
  0%{transform:translate(14px,98px)}
  45%{transform:translate(120px,98px)}
  58%{transform:translate(150px,8px)}
  70%{transform:translate(178px,98px)}
  100%{transform:translate(250px,98px)}}
.zero{position:absolute;right:8px;bottom:10px;font-family:'Space Mono',monospace;
  font-size:13px;font-weight:700;letter-spacing:.14em;color:#51e08a;
  opacity:0;animation:fade .4s ease-out 2.9s forwards}

/* lower-third */
.rest{position:absolute;left:54px;top:130px;
  opacity:0;transform:translateX(-20px);animation:slidein .6s cubic-bezier(.16,1,.3,1) 1.2s forwards}
.rest .r1{font-family:'Space Mono',monospace;font-size:16px;letter-spacing:.28em;color:#51e08a;margin:0 0 4px}
.rest .r2{font-size:34px;font-weight:500;letter-spacing:.08em;text-transform:uppercase;margin:0}

/* hero payoff */
.hero{position:absolute;left:54px;bottom:90px}
.htick{position:absolute;left:-18px;top:6px;width:5px;height:120px;background:#fff;
  transform:scaleY(0);transform-origin:top;animation:grow .6s cubic-bezier(.2,.8,.2,1) 3.2s forwards}
.hkick{font-size:24px;font-weight:300;letter-spacing:.32em;color:#fff;text-transform:uppercase;
  margin:0 0 12px 2px;opacity:0;transform:translateY(14px);
  animation:rise .7s cubic-bezier(.16,1,.3,1) 3.3s forwards}
.hbig{font-size:96px;font-weight:700;letter-spacing:.02em;line-height:.94;margin:0;text-transform:uppercase;
  text-shadow:2px 0 0 #000,-2px 0 0 #000,0 2px 0 #000,0 -2px 0 #000,5px 6px 0 rgba(0,0,0,.72);
  opacity:0;transform:translateY(30px) scale(1.04);
  animation:risebig .8s cubic-bezier(.16,1,.3,1) 4.8s forwards}
.hbig em{font-style:normal;color:#7ddcff}

@keyframes fade{to{opacity:1}}
@keyframes rise{to{opacity:1;transform:translateY(0)}}
@keyframes risebig{to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes slidein{to{opacity:1;transform:translateX(0)}}
@keyframes grow{to{transform:scaleY(1)}}
</style></head><body>
  <video class="vid" src="../scene-03.mp4" muted></video>
  <div class="grade"></div>
  <div class="vignette"></div>

  <div class="topbar"><span class="rec"></span><span class="lbl">REC&nbsp;&nbsp;FIELD UNIT 07</span></div>

  <div class="hud">
    <div class="h"><b>VELOCITY · v/t</b><i>PLOT</i></div>
    <div class="graph">
      <svg width="264" height="120" viewBox="0 0 264 120">
        <line x1="20" y1="6" x2="20" y2="104" stroke="rgba(255,255,255,.35)" stroke-width="1.5"/>
        <line x1="20" y1="104" x2="258" y2="104" stroke="rgba(255,255,255,.35)" stroke-width="1.5"/>
        <polyline class="curve" points="20,104 120,104 150,14 178,104 256,104"
          fill="none" stroke="#51e08a" stroke-width="3" stroke-linejoin="round" stroke-linecap="round"/>
      </svg>
      <div class="dot"></div>
      <div class="zero">→ 0</div>
    </div>
  </div>

  <div class="rest">
    <p class="r1">SUBJECT STATUS</p>
    <p class="r2">At Rest</p>
  </div>

  <div class="hero">
    <div class="htick"></div>
    <p class="hkick">Peace returns to the savannah</p>
    <p class="hbig">Until <em>3:00 AM</em></p>
  </div>
</body></html>
