<!DOCTYPE html><html><head><meta charset="utf-8"><style>
@import url('https://fonts.googleapis.com/css2?family=Oswald:wght@300;400;500;700&family=Space+Mono:wght@400;700&display=swap');
html,body{margin:0;padding:0}
body{width:1280px;height:720px;position:relative;overflow:hidden;background:#000;
  font-family:'Oswald',sans-serif;color:#fff}
*{text-shadow:1px 0 0 #000,-1px 0 0 #000,0 1px 0 #000,0 -1px 0 #000,2px 2px 0 rgba(0,0,0,.6)}
.vid{position:absolute;inset:0;width:1280px;height:720px;object-fit:cover}

.vignette{position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(125% 95% at 50% 46%, rgba(0,0,0,0) 52%, rgba(0,0,0,.58) 100%)}
.grade{position:absolute;inset:0;pointer-events:none;
  background:linear-gradient(180deg, rgba(20,8,8,.3) 0%, rgba(0,0,0,0) 22%, rgba(0,0,0,0) 60%, rgba(8,4,4,.55) 100%)}

/* topbar */
.topbar{position:absolute;top:36px;left:48px;display:flex;align-items:center;gap:14px;
  opacity:0;animation:fade .4s ease-out .2s forwards}
.rec{width:13px;height:13px;border-radius:50%;background:#ff3b30;animation:blink .7s steps(1,end) infinite}
.topbar .lbl{font-family:'Space Mono',monospace;font-size:17px;letter-spacing:.34em;font-weight:700}
@keyframes blink{0%,49%{opacity:1}50%,100%{opacity:.12}}

/* lower-third phase label */
.phase{position:absolute;left:54px;bottom:64px;
  opacity:0;transform:translateX(-22px);animation:slidein .6s cubic-bezier(.16,1,.3,1) .4s forwards}
.phase .p1{font-family:'Space Mono',monospace;font-size:18px;letter-spacing:.3em;color:#ff6a5a;margin:0 0 4px}
.phase .p2{font-size:40px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;margin:0}

/* data tags top-right */
.tags{position:absolute;top:120px;right:50px;text-align:right;font-family:'Space Mono',monospace}
.tags div{font-size:16px;letter-spacing:.16em;margin-bottom:10px;opacity:0;animation:fade .3s ease-out forwards}
.tags .d1{animation-delay:1s}.tags .d2{animation-delay:1.3s}.tags .d3{animation-delay:1.6s}
.tags b{color:#ff6a5a;font-weight:700}
.tags s{color:#51e08a;text-decoration:none;font-weight:700}

/* tracking reticle */
.reticle{position:absolute;left:445px;top:185px;width:390px;height:320px;
  opacity:0;animation:fade .3s ease-out .6s forwards, jit .5s ease-in-out .6s infinite alternate}
.reticle .c{position:absolute;width:38px;height:38px;border:3px solid rgba(255,255,255,.9)}
.reticle .tl{left:0;top:0;border-right:0;border-bottom:0}
.reticle .tr{right:0;top:0;border-left:0;border-bottom:0}
.reticle .bl{left:0;bottom:0;border-right:0;border-top:0}
.reticle .br{right:0;bottom:0;border-left:0;border-top:0}
.reticle .tg{position:absolute;left:0;bottom:-26px;font-family:'Space Mono',monospace;
  font-size:14px;letter-spacing:.24em;color:#fff}
@keyframes jit{
  0%{transform:translate(0,0)}25%{transform:translate(-7px,4px)}
  50%{transform:translate(5px,-5px)}75%{transform:translate(-4px,-3px)}100%{transform:translate(6px,5px)}}

/* THE ZOOMIES slam */
.slam{position:absolute;left:0;right:0;bottom:150px;text-align:center;
  opacity:0;transform:scale(1.35);
  animation:slam .42s cubic-bezier(.2,1.5,.3,1) 6.4s forwards}
.slam .s1{font-size:34px;font-weight:300;letter-spacing:.5em;color:#ff6a5a;text-transform:uppercase;margin:0 0 6px}
.slam .s2{font-size:130px;font-weight:700;letter-spacing:.03em;text-transform:uppercase;line-height:.9;margin:0;
  text-shadow:2px 0 0 #000,-2px 0 0 #000,0 2px 0 #000,0 -2px 0 #000,5px 6px 0 rgba(0,0,0,.72)}
@keyframes slam{to{opacity:1;transform:scale(1)}}

@keyframes fade{to{opacity:1}}
@keyframes slidein{to{opacity:1;transform:translateX(0)}}
</style></head><body>
  <video class="vid" src="../scene-02.mp4" muted></video>
  <div class="grade"></div>
  <div class="vignette"></div>

  <div class="topbar"><span class="rec"></span><span class="lbl">REC&nbsp;&nbsp;FIELD UNIT 07</span></div>

  <div class="tags">
    <div class="d1">VELOCITY&nbsp;&nbsp;<b>HIGH</b></div>
    <div class="d2">STATUS&nbsp;&nbsp;<b>AIRBORNE</b></div>
    <div class="d3">THREAT&nbsp;&nbsp;<s>NONE</s></div>
  </div>

  <div class="reticle">
    <div class="c tl"></div><div class="c tr"></div><div class="c bl"></div><div class="c br"></div>
    <div class="tg">▣ TRACKING SUBJECT</div>
  </div>

  <div class="phase">
    <p class="p1">PHASE 02</p>
    <p class="p2">The Frenzy</p>
  </div>

  <div class="slam">
    <p class="s1">The Apex Predator Engages</p>
    <p class="s2">The Zoomies</p>
  </div>
</body></html>
